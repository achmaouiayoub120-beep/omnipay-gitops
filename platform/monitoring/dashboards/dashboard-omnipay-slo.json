{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "OmniPay Zero-Trust — Executive SLOs & Golden Signals (P5 S2)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "🏦 Disponibilité Transaction Service (SLO 99.5%)",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.98,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.99 },
              { "color": "green", "value": 0.995 }
            ]
          },
          "mappings": []
        }
      },
      "targets": [
        {
          "expr": "1 - (sum(rate(http_server_requests_seconds_count{uri=\"/api/transactions/transfer\",status=~\"5..\"}[30d])) or vector(0)) / (sum(rate(http_server_requests_seconds_count{uri=\"/api/transactions/transfer\"}[30d])) or vector(1))",
          "legendFormat": "Disponibilité 30j",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "💰 Budget d'Erreur Restant (%)",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "green", "value": 50 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "100 * (1 - (sum(increase(http_server_requests_seconds_count{uri=\"/api/transactions/transfer\",status=~\"5..\"}[30d])) or vector(0)) / (sum(increase(http_server_requests_seconds_count{uri=\"/api/transactions/transfer\"}[30d])) * 0.005 or vector(1)))",
          "legendFormat": "Budget restant",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "⏱️ Latence Transactionnelle P95 & P99 (SLO < 200ms)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.2 }
            ]
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=\"/api/transactions/transfer\"}[5m])) by (le))",
          "legendFormat": "p95 latence",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{uri=\"/api/transactions/transfer\"}[5m])) by (le))",
          "legendFormat": "p99 latence",
          "refId": "B"
        },
        {
          "expr": "vector(0.2)",
          "legendFormat": "Seuil SLO 200ms",
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "🚦 Trafic / Débit RPS par Microservice",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\".*auth.*\"}[5m]))",
          "legendFormat": "auth-service RPS",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\".*transaction.*\"}[5m]))",
          "legendFormat": "transaction-service RPS",
          "refId": "B"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\".*notification.*\"}[5m]))",
          "legendFormat": "notification-service RPS",
          "refId": "C"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "🔴 Taux d'Erreurs HTTP 4xx & 5xx en Temps Réel",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "Taux erreurs 5xx",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"4..\"}[5m])) / sum(rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "Taux erreurs 4xx",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["omnipay", "slo", "golden-signals", "p5"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
